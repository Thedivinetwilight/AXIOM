# AXIOM Kronos configuration (read by desktop/forecast_controller.py through
# axiom.bootstrap). This file is separate from Arena's .env on purpose: Arena
# 3.0.5 owns trading configuration, AXIOM owns forecasting configuration.
#
# Kronos is a FORECASTING subsystem. It cannot place orders, change risk limits
# or enable LIVE trading — those controls do not exist in this file.

# --- master switch -----------------------------------------------------------
# Kronos is OFF unless this is true. With it false the terminal runs exactly as
# before and the FORECAST panel shows DISABLED.
AXIOM_KRONOS_ENABLED=false

# "upstream" = the real Kronos model (needs the Kronos runtime dependencies).
# "stub"     = deterministic placeholder trajectories for development only;
#              every result is labelled backend=stub.
AXIOM_KRONOS_BACKEND=upstream

# --- model -------------------------------------------------------------------
AXIOM_KRONOS_MODEL=NeoQuasar/Kronos-small
AXIOM_KRONOS_MODEL_REVISION=
AXIOM_KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
AXIOM_KRONOS_TOKENIZER_REVISION=
# auto | cpu | cuda:0 | mps
AXIOM_KRONOS_DEVICE=auto
# Download weights on first load (false = load from the local cache only).
AXIOM_KRONOS_ALLOW_DOWNLOAD=false
# Override the runtime model cache (default %LOCALAPPDATA%\AXIOM\models\kronos).
AXIOM_MODEL_CACHE=

# --- inference ---------------------------------------------------------------
# Kronos-small / Kronos-base have a 512 context length; lookback must fit.
AXIOM_KRONOS_LOOKBACK=400
AXIOM_KRONOS_PRED_LEN=120
AXIOM_KRONOS_MAX_CONTEXT=512
AXIOM_KRONOS_TEMPERATURE=1.0
AXIOM_KRONOS_TOP_K=0
AXIOM_KRONOS_TOP_P=0.9
# >= 3 sampled paths are required before P10/P50/P90 dispersion is displayed.
AXIOM_KRONOS_SAMPLE_PATHS=1
AXIOM_KRONOS_MIN_HISTORY=64
# Re-run only when a new CLOSED candle changes the input window.
AXIOM_KRONOS_UPDATE_ON_CLOSED_BAR=true
# A forecast older than this is shown as STALE (seconds).
AXIOM_KRONOS_STALE_AFTER=3600

# --- process isolation -------------------------------------------------------
# process     = spawn AXIOM-Kronos (python -m axiom.worker.child)  [preferred]
# in-process  = run the Kronos runtime inside the terminal process
AXIOM_KRONOS_MODE=process

# --- market data (Arena 3.0.5 exposes no authoritative candle endpoint) ------
# replay = deterministic replay of a RECORDED CSV (offline development)
# http   = a real JSON candle endpoint
AXIOM_MARKET_DATA_SOURCE=replay
AXIOM_MARKET_DATA_CSV=data/sample_1h.csv
# The timeframe is DECLARED, never inferred.
AXIOM_MARKET_DATA_TIMEFRAME=1h
# For source=http:
# AXIOM_MARKET_DATA_URL=https://api.example.com/candles?symbol={instrument}&tf={timeframe}&limit={limit}
# AXIOM_MARKET_DATA_TOKEN=
# AXIOM_MARKET_DATA_JSON_PATH=data.candles
# AXIOM_MARKET_DATA_TIMEOUT=20

# --- session calendar (future timestamps must respect it) --------------------
# continuous | daily | session
AXIOM_MARKET_CALENDAR=continuous
# AXIOM_MARKET_SESSION_OPEN=09:15
# AXIOM_MARKET_SESSION_CLOSE=15:30
# AXIOM_MARKET_WEEKDAYS=0-4

# --- what to forecast --------------------------------------------------------
# INSTRUMENT:TIMEFRAME pairs, comma separated.
AXIOM_FORECAST_SERIES=DEMO:1h

# --- Kronos implementation location (not a PyPI package) ---------------------
# AXIOM_KRONOS_SOURCE=%LOCALAPPDATA%\AXIOM\Kronos
