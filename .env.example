# Defaults are paper-only. Real-money routing is a four-switch opt-in (see
# the V2 LIVE block below); neither variable alone can enable it.
INITIAL_CAPITAL=100000
CURRENCY=INR
DEFAULT_SYMBOL=DEMO
DEFAULT_TIMEFRAME=1D
COMMISSION=0.0005
SLIPPAGE=0.0005
SPREAD=0.0002
POSITION_SIZE=0.25
STOP_LOSS=0.05
TAKE_PROFIT=0.10
MAX_PARTICIPATION=0.10
DATABASE_URL=sqlite:///trading_bot.db
# Required for API endpoints other than /health; set a private random value.
API_TOKEN=
# Replay is default. Binance is read-only public crypto data, NOT Indian equities.
# DATA_SOURCE=upstox enables the V0.6.1 real Indian market DATA feed (paper only).
# DATA_SOURCE=alpaca enables read-only US equity bars with local PAPER fills;
# see docs/US_EQUITIES_PAPER.md before selecting it.
DATA_SOURCE=replay
MARKET_DATA_TOKEN=
# --- V0.6.1 real market DATA (Upstox, read-only; order endpoints never called) ---
# Provider; only market data. Execution stays 100% simulated in PaperBroker.
MARKET_DATA_PROVIDER=upstox
# Comma-separated Upstox instrument keys. Start with ONE liquid instrument, e.g.
# NSE_EQ|INE002A01018 (Reliance Industries). Do not subscribe to hundreds first.
MARKET_DATA_SYMBOLS=
# Must equal DEFAULT_TIMEFRAME. 1m is the smallest supported live timeframe.
MARKET_DATA_TIMEFRAME=1m
# ltpc builds candles from live ticks (any intraday timeframe); full uses the
# official aggregate bars, which Upstox publishes for 1m/30m only. Readiness
# refuses a pairing the data adapter would reject.
MARKET_DATA_MODE=ltpc
# Upstox access token (from your own developer account). Never logged/returned.
MARKET_DATA_ACCESS_TOKEN=
# --- Alpaca US market data (read-only; no order endpoint is used) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
ALPACA_SYMBOLS=
# US paper setup: MARKET=us, CURRENCY=USD, MARKET_CALENDAR=us-equities,
# DEFAULT_SYMBOL=AAPL, DEFAULT_TIMEFRAME=1m, BROKER=LOCAL_PAPER.
# Completed 1m bars fetched at start so indicators are warm (0 disables).
ALPACA_BACKFILL_BARS=240
# Choose and bound ALL paper limits before enabling this provider; the Alpaca
# path refuses to start while any of them is zero.
# PAPER_MAX_POSITION_VALUE=1000
# PAPER_MAX_OPEN_POSITIONS=2
# PAPER_MAX_DAILY_LOSS=100
# PAPER_MAX_DRAWDOWN=0.05
# PAPER_MAX_TRADES_PER_DAY=4
# PAPER_MAX_GROSS_EXPOSURE=0.60
# BLOCK_ENTRIES (cancel entries only) or FLATTEN (also exit inventory)
PAPER_HALT_POLICY=BLOCK_ENTRIES
# Extraordinary US session changes from an exchange notice (ISO dates, commas).
# US_CLOSED_DATES=
# US_EARLY_CLOSE_DATES=
# V0.6.2 aliases: UPSTOX_ACCESS_TOKEN / UPSTOX_INSTRUMENT_KEYS are accepted with
# the same meaning (explicit MARKET_DATA_* variables win if both are set).
# V0.6.3 credential types (never assume): a standard OAuth login access token
# (daily; python -m app upstox-login) is the documented path for Market Data
# Feed V3. The 1-year read-only Analytics Token lists a 'Websocket' category in
# the current docs, but feed access is verified BEHAVIORALLY before any
# connection (`python -m app upstox-test`); wrong/expired credentials are
# rejected with guidance and NO connection is attempted.
# OAuth login helper (python -m app upstox-login) additionally uses:
#   UPSTOX_CLIENT_ID=<your API key>
#   UPSTOX_CLIENT_SECRET=<your API secret>
#   UPSTOX_REDIRECT_URI=<redirect URI registered on your Upstox app>
# Official V3 authorize endpoint; override only for local protocol tests.
# MARKET_DATA_AUTHORIZE_URL=https://api.upstox.com/v3/feed/market-data-feed/authorize
# For future authenticated DATA adapters only; no broker credentials needed.
LOG_LEVEL=INFO
# Generic WSS candle feed (optional; never a broker/order endpoint).
DATA_WS_URL=
# continuous for synthetic/crypto; nse-session is an intraday weekday example only.
MARKET_CALENDAR=continuous

# --- V1 (Arena): explicit broker modes; real money is gated (V2) ---
# BROKER selects the execution backend:
#   LOCAL_PAPER     (default) in-process simulation, nothing leaves the machine
#   UPSTOX_SANDBOX  real HTTP orders on Upstox's SANDBOX host (no real money)
#   UPSTOX_LIVE     REAL MONEY — requires the four-switch opt-in below AND
#                   non-zero hard risk limits; see LIVE_TRADING_ENABLEMENT.md
BROKER=LOCAL_PAPER
# Upstox SANDBOX token (Developer Apps > Sandbox). Sandbox tokens can only
# reach the documented sandbox order APIs, never live order endpoints.
UPSTOX_SANDBOX_ACCESS_TOKEN=
# Sandbox order/history requests are confined to sandbox hosts. Never set
# either URL to api.upstox.com or api-hft.upstox.com; history may be unsupported
# by the sandbox provider and is reported as an unavailable capability.
# UPSTOX_SANDBOX_BASE_URL=https://api-sandbox.upstox.com
# UPSTOX_SANDBOX_ORDER_HISTORY_URL=https://api-sandbox.upstox.com/v2/order/history
SANDBOX_PRODUCT=I
SANDBOX_ORDER_TAG=arena-v1

# --- V2 (Arena LIVE): REAL MONEY — OFF unless ALL FOUR switches agree -------
# 1) BROKER=UPSTOX_LIVE   2) MODE=LIVE   3) LIVE_TRADING=true
# 4) LIVE_CONFIRM=I-ACCEPT-REAL-MONEY-RISK
# PLUS: MAX_POSITION_VALUE, MAX_OPEN_POSITIONS, MAX_DAILY_LOSS and
# MAX_TRADES_PER_DAY must all be explicitly NON-ZERO (0 = unlimited, refused).
# Any missing switch aborts startup with a message naming what is missing.
# Read LIVE_TRADING_ENABLEMENT.md and the preflight command before enabling:
#   python -m app live-preflight        (read-only; never places an order)
MODE=PAPER
LIVE_TRADING=false
LIVE_CONFIRM=
UPSTOX_LIVE_ACCESS_TOKEN=
# UPSTOX_LIVE_BASE_URL=https://api-hft.upstox.com   # the live order host
# UPSTOX_LIVE_ORDER_HISTORY_URL=https://api.upstox.com/v2/order/history
LIVE_PRODUCT=I
LIVE_ORDER_TAG=arena-live
# Optional: required only if your app has an exchange-approved algo name.
LIVE_ALGO_NAME=

# --- V2.1 (Arena L-ops): live operations safety rails ------------------------
# Guards gate NEW ENTRIES only. Exits and protective stops are NEVER blocked by
# an operational rail. All of these are inert unless the live opt-in above is
# satisfied; the defaults below are the fail-closed choices.
# Canary ramp: cap the notional of the first LIVE_CANARY_ORDERS entries
# (0 = no ramp; every rule of the ramp then uses full size immediately).
LIVE_CANARY_MAX_NOTIONAL=0
LIVE_CANARY_ORDERS=10
# Credential freshness: the engine refuses new entries when the last verified
# credential is older than this; run `python -m app live-preflight` to verify
# (that is what records freshness). 0 disables the check.
LIVE_TOKEN_MAX_AGE_HOURS=20
LIVE_TOKEN_WARN_MINUTES=120
# Watchdog: alert when an order stays working longer than this (WARNING), and
# escalate to CRITICAL after LIVE_STUCK_ORDER_ESCALATE_MINUTES.
LIVE_STUCK_ORDER_MINUTES=5
LIVE_STUCK_ORDER_ESCALATE_MINUTES=15
LIVE_RECONCILE_SILENCE_MINUTES=10
# A CRITICAL alert nobody has acknowledged after this many minutes becomes an
# incident of its own (0 disables). Acknowledge with `python -m app live-ack`.
LIVE_UNACKED_CRITICAL_MINUTES=15
# Single-engine lock: a LIVE engine refuses to start while another live engine's
# heartbeat is this fresh. A crashed engine's heartbeat goes stale and never
# blocks a restart (override with `python -m app engine --force-live-lock`).
LIVE_LOCK_STALE_SECONDS=180
# Optional: let the engine cancel orders the watchdog escalated to CRITICAL.
# Off by default — cancelling is an action and needs an explicit opt-in.
LIVE_AUTO_CANCEL_STUCK=false
# Auto-stop: on a daily-loss / drawdown breach, trigger the persisted
# EMERGENCY STOP from inside the engine (fail-closed default: ON).
LIVE_AUTO_STOP_ON_BREACH=true
# Peak-equity drawdown kill switch as a fraction (0.10 = 10%; 0 = disabled).
LIVE_MAX_EQUITY_DRAWDOWN=0
# Alerts: the durable sink is always system_events (kind ALERT). An optional
# webhook receives alerts at/above ALERT_MIN_SEVERITY (INFO|WARNING|CRITICAL);
# identical alerts are collapsed for ALERT_DEDUP_SECONDS.
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=WARNING
ALERT_DEDUP_SECONDS=300
# A failed webhook POST is retried with exponential backoff (0 = no retry).
# The durable sink above already holds the alert either way.
ALERT_RETRY_ATTEMPTS=3
ALERT_RETRY_BACKOFF_SECONDS=60
# Hard risk limits (learning can NEVER change these; 0 = unlimited/disabled).
# In LIVE mode these four MUST all be non-zero: unlimited real-money trading
# is refused at startup.
MAX_POSITION_VALUE=0
MAX_OPEN_POSITIONS=0
MAX_DAILY_LOSS=0
MAX_TRADES_PER_DAY=0

# --- V2.1 (Arena): market intelligence + data platform ---
# Local data directory (candle store, universe cache, datasets).
DATA_DIR=data
# Official Upstox instrument master (per-exchange files also work, e.g.
# https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz).
UNIVERSE_SYNC_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
# Historical Candle V3 endpoints (documented defaults).
# HISTORY_BASE_URL=https://api.upstox.com/v3/historical-candle
# INTRADAY_BASE_URL=https://api.upstox.com/v3/historical-candle/intraday
# Parquet output when pyarrow is installed (falls back to csv.gz automatically).
PARQUET_ENABLED=true
# Active STREAMING universe: explicit comma-separated instrument keys ONLY.
# Subscribing to the entire instrument universe is refused by design.
UPSTOX_STREAMING_UNIVERSE=NSE_EQ|INE002A01018
# Daily maintenance hour (UTC) used by the 24/7 engine scheduler.
MAINTENANCE_HOUR=17
MAX_DOWNLOAD_RETRIES=3
RESEARCH_BATCH_SIZE=30

# --- FINAL: research/portfolio/event knobs (hard caps are NOT learning-editable) ---
MAX_STRATEGY_ALLOCATION=0.35
EVENT_MOVE_THRESHOLD=0.003
EVENT_VOLUME_SPIKE=2.0
SCANNER_TOP_K=5
DISCOVERY_MAX_CANDIDATES=12
