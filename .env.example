# Safety settings cannot be overridden to enable real trading.
MODE=PAPER
LIVE_TRADING=false
INITIAL_CAPITAL=100000
CURRENCY=INR
DEFAULT_SYMBOL=DEMO
DEFAULT_TIMEFRAME=1D
COMMISSION=0.0005
SLIPPAGE=0.0005
SPREAD=0.0002
POSITION_SIZE=0.25
STOP_LOSS=0.05
TAKE_PROFIT=0.10
MAX_PARTICIPATION=0.10
DATABASE_URL=sqlite:///trading_bot.db
# Required for API endpoints other than /health; set a private random value.
API_TOKEN=
# Serve the /dashboard and /chart HTML pages to remote clients, for a deployment
# behind a reverse proxy. The pages contain no secrets and every data route
# still requires API_TOKEN. Leave false for a local-only installation.
# UI_ALLOW_PROXY_PAGES=false
# Replay is default. Binance is read-only public crypto data, NOT Indian equities.
# DATA_SOURCE=upstox enables the V0.6.1 real Indian market DATA feed (paper only).
DATA_SOURCE=replay
MARKET_DATA_TOKEN=
# --- V0.6.1 real market DATA (Upstox, read-only; order endpoints never called) ---
# Provider; only market data. Execution stays 100% simulated in PaperBroker.
MARKET_DATA_PROVIDER=upstox
# Comma-separated Upstox instrument keys. Start with ONE liquid instrument, e.g.
# NSE_EQ|INE002A01018 (Reliance Industries). Do not subscribe to hundreds first.
MARKET_DATA_SYMBOLS=
# Must equal DEFAULT_TIMEFRAME. 1m is the smallest supported live timeframe.
MARKET_DATA_TIMEFRAME=1m
# ltpc builds candles from live ticks; full uses official 1m/30m aggregate bars.
MARKET_DATA_MODE=ltpc
# Upstox access token (from your own developer account). Never logged/returned.
MARKET_DATA_ACCESS_TOKEN=
# V0.6.2 aliases: UPSTOX_ACCESS_TOKEN / UPSTOX_INSTRUMENT_KEYS are accepted with
# the same meaning (explicit MARKET_DATA_* variables win if both are set).
# V0.6.3 credential types (never assume): a standard OAuth login access token
# (daily; python -m app upstox-login) is the documented path for Market Data
# Feed V3. The 1-year read-only Analytics Token lists a 'Websocket' category in
# the current docs, but feed access is verified BEHAVIORALLY before any
# connection (`python -m app upstox-test`); wrong/expired credentials are
# rejected with guidance and NO connection is attempted.
# OAuth login helper (python -m app upstox-login) additionally uses:
#   UPSTOX_CLIENT_ID=<your API key>
#   UPSTOX_CLIENT_SECRET=<your API secret>
#   UPSTOX_REDIRECT_URI=<redirect URI registered on your Upstox app>
# Official V3 authorize endpoint; override only for local protocol tests.
# MARKET_DATA_AUTHORIZE_URL=https://api.upstox.com/v3/feed/market-data-feed/authorize
# For future authenticated DATA adapters only; no broker credentials needed.
LOG_LEVEL=INFO
# Generic WSS candle feed (optional; never a broker/order endpoint).
DATA_WS_URL=
# continuous for synthetic/crypto; nse-session is an intraday weekday example only.
MARKET_CALENDAR=continuous

# --- V1 (Arena): explicit broker modes; LIVE IS NOT ENABLED ---
# BROKER selects the execution backend: LOCAL_PAPER (default) or UPSTOX_SANDBOX.
BROKER=LOCAL_PAPER
# Upstox SANDBOX token (Developer Apps > Sandbox). Sandbox tokens can only
# reach the documented sandbox order APIs, never live order endpoints.
UPSTOX_SANDBOX_ACCESS_TOKEN=
# Documented V3 order host (Place/Cancel/Modify V3) and order-history endpoint.
# UPSTOX_SANDBOX_BASE_URL=https://api-hft.upstox.com
# UPSTOX_SANDBOX_ORDER_HISTORY_URL=https://api.upstox.com/v2/order/history
SANDBOX_PRODUCT=I
SANDBOX_ORDER_TAG=arena-v1
# Hard risk limits (learning can NEVER change these; 0 = unlimited/disabled).
MAX_POSITION_VALUE=0
MAX_OPEN_POSITIONS=0
MAX_DAILY_LOSS=0
MAX_TRADES_PER_DAY=0

# --- V2.1 (Arena): market intelligence + data platform ---
# Local data directory (candle store, universe cache, datasets).
DATA_DIR=data
# Official Upstox instrument master (per-exchange files also work, e.g.
# https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz).
UNIVERSE_SYNC_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
# Historical Candle V3 endpoints (documented defaults).
# HISTORY_BASE_URL=https://api.upstox.com/v3/historical-candle
# INTRADAY_BASE_URL=https://api.upstox.com/v3/historical-candle/intraday
# Parquet output when pyarrow is installed (falls back to csv.gz automatically).
PARQUET_ENABLED=true
# Active STREAMING universe: explicit comma-separated instrument keys ONLY.
# Subscribing to the entire instrument universe is refused by design.
UPSTOX_STREAMING_UNIVERSE=NSE_EQ|INE002A01018
# Daily maintenance hour (UTC) used by the 24/7 engine scheduler.
MAINTENANCE_HOUR=17
MAX_DOWNLOAD_RETRIES=3
RESEARCH_BATCH_SIZE=30

# --- FINAL: research/portfolio/event knobs (hard caps are NOT learning-editable) ---
MAX_STRATEGY_ALLOCATION=0.35
EVENT_MOVE_THRESHOLD=0.003
EVENT_VOLUME_SPIKE=2.0
SCANNER_TOP_K=5
DISCOVERY_MAX_CANDIDATES=12
