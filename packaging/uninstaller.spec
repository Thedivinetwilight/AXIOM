# PyInstaller spec for the standalone Arena Deep Uninstaller.
#
# Build with:  python build_uninstaller.py            (recommended)
# or:          pyinstaller packaging/uninstaller.spec --noconfirm
#
# This spec deliberately bundles ONE module tree: ``uninstaller/`` and its
# entry script. The Arena application is not bundled and not imported — the
# resulting Arena-Uninstall.exe keeps working when Arena is closed, corrupted
# or completely removed, which is the whole point of shipping it separately.
#
# The package is standard-library only, so the excludes below simply keep
# PyInstaller from dragging in anything the host environment happens to have
# installed. A build that grows a dependency should fail loudly instead of
# quietly producing a 200 MB uninstaller.

import os
from pathlib import Path

ROOT = Path(SPECPATH).resolve().parent
VERSION_FILE = ROOT / "build" / "uninstaller-version.txt"

# An optional Windows version resource (generated by build_uninstaller.py).
version_arg = None
if VERSION_FILE.exists():
    version_arg = str(VERSION_FILE)
elif os.environ.get("ARENA_UNINSTALL_VERSION_FILE"):
    version_arg = os.environ["ARENA_UNINSTALL_VERSION_FILE"]

excludes = [
    "app", "desktop", "axiom", "scripts", "tools", "tests",
    "fastapi", "starlette", "uvicorn", "pydantic", "httpx", "httpcore",
    "anyio", "websockets", "protobuf", "dotenv", "numpy", "pandas",
    "torch", "PySide6", "PyQt5", "PyQt6", "matplotlib", "scipy",
    "setuptools", "pip", "wheel", "pytest", "_pytest",
    "tkinter", "unittest", "pydoc", "doctest", "email", "xml", "xmlrpc",
    "lib2to3", "multiprocessing", "asyncio", "concurrent", "sqlite3",
    "curses", "distutils", "ensurepip", "venv", "zipapp",
]

a = Analysis(
    [str(ROOT / "arena_uninstall.py")],
    pathex=[str(ROOT)],
    binaries=[],
    datas=[],
    hiddenimports=["uninstaller", "uninstaller.cli"],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="Arena-Uninstall",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    version=version_arg,
)
